{
  "manifest_version": 3,
  "name": "销卡管理列表",
  "version": "1.3.1",
  "description": "销卡管理列表自动点击退款并确定，保留默认金额，支持翻页、停止及日志。",
  "content_scripts": [
    {
      "matches": [
        "https://example.com/*"
      ],
      "js": [
        "helper.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
